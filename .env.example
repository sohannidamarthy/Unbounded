DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
REDIS_URL=redis://default:PASSWORD@HOST:6379
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGINS=https://your-frontend.vercel.app
ENV=production

# Odds provider integration.
# ODDS_API_KEY is the generic fallback; ODDSJAM_API_KEY is for OddsJam-specific ingestion.
ODDS_API_KEY=
ODDSJAM_API_KEY=
ARB_SPORTS=nba,nfl,mlb,mls,epl
ARB_SCAN_HORIZON_HOURS=6
ARB_MIN_ROI=0.0001

# Optional, only needed for newsletter emails.
RESEND_API_KEY=
WAITLIST_FROM_EMAIL=
WAITLIST_NOTIFY_EMAIL=

# Optional, used for account verification and password reset emails.
AUTH_FROM_EMAIL=
FRONTEND_SITE_URL=https://your-frontend.vercel.app
