{
  "name": "unbounded-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0 <21"
  },
  "scripts": {
    "clean": "rm -rf .next .next-dev node_modules/.cache",
    "clean:build": "rm -rf .next",
    "clean:dev": "rm -rf .next-dev node_modules/.cache",
    "free-port:3001": "sh -c 'lsof -tiTCP:3001 | xargs kill -9 2>/dev/null || true'",
    "predev": "npm run clean:dev",
    "dev": "next dev",
    "predev:3001": "npm run free-port:3001 && npm run clean:dev",
    "dev:3001": "next dev -H 127.0.0.1 -p 3001",
    "prebuild": "npm run clean:build",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "typescript": "5.5.3"
  }
}
